# ============================================================================
# Docker Stack - Environment Variables Example (Development)
# ============================================================================
# Copy this file to `.env` and adjust for your environment.
#
# This file configures the full Docker stack:
#   - db        : PostgreSQL
#   - migrate   : one-shot migration job
#   - website   : Node.js API
#
# Seeds are NOT part of the Docker stack: they are dev-only demo data.
# Run them locally with `npm run db:seed` from `backend/` when needed.
# ============================================================================

# DEV-ONLY: tell Docker Compose to layer docker-compose.dev.yml on top of the
# base file. The dev override exposes ports on the host (db, minio, website,
# documenso, browser) which is convenient locally but dangerous in prod.
# Separator: ';' on Windows, ':' on Unix.
# In prod, this variable MUST NOT be set so that `docker compose up` loads only
# docker-compose.yml.
COMPOSE_FILE=docker-compose.yml;docker-compose.dev.yml

# ENVIRONMENT
# Combined with APP_NAME to build container names and DNS aliases.
# Container name pattern:   ${ENVIRONMENT}-${APP_NAME}-<service>
#                           (e.g. prod-gazmatek-agency-documenso)
# Public alias on covaltech-network (used by Caddy):
#                           ${APP_NAME}-<service>
#                           (e.g. gazmatek-agency-website, gazmatek-agency-minio)
# Values: dev | staging | prod
ENVIRONMENT=dev

# APP CONFIGURATION
# ============================================================================
NODE_ENV=development
APP_NAME=backend-template
APP_VERSION=1.0.0
APP_BASE_URL=http://localhost:4001
PORT=4001
APP_TIMEZONE=UTC

# SERVER
# ============================================================================
CORS_ORIGIN=http://localhost
TRUST_PROXY=true

# DATABASE
# ============================================================================
# Docker uses the internal service name `db` as hostname.
DATABASE_HOST=db
DATABASE=mydb
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_PORT=5432

# Connection pool tuning (optional - sane defaults applied when omitted).
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# AUTHENTICATION
# ============================================================================
# JWT_KEY is required when AUTH_STRATEGIES includes 'jwt'.
# Recommendation: generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_KEY=your-secret-jwt-key-here-32-bytes-min
AUTH_STRATEGIES=jwt
API_KEY_HEADER=x-api-key

# DATA ENCRYPTION (REQUIRED)
# ============================================================================
# AES-256-GCM key for application-level field encryption.
# Must be a 64-character hex string (32 bytes). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: keep this value stable and backed up - losing it makes every
# encrypted field permanently unreadable.
DATA_ENCRYPTION_KEY=

# LOGGING
# ============================================================================
LOG_LEVEL=debug
LOG_PATH=logs

# FEATURES
# ============================================================================
FEATURE_SWAGGER=true
FEATURE_METRICS=true
FEATURE_NOTIFICATIONS=false
FEATURE_STORAGE=true
FEATURE_MAILER=false
# Background job scheduler (e.g. token cleanup, scheduled reminders)
FEATURE_JOBS=false

# SWAGGER / API DOCUMENTATION
# ============================================================================
SWAGGER_PATH=/docs
SWAGGER_JSON_PATH=/docs/json
SWAGGER_TITLE=Backend Template API

# METRICS (Prometheus)
# ============================================================================
METRICS_PATH=/metrics

# OBSERVABILITY
# ============================================================================
REQUEST_ID_HEADER=x-request-id

# RATE LIMITING
# ============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_API=300
RATE_LIMIT_MAX_AUTH=20
RATE_LIMIT_MAX_DOCS=60
RATE_LIMIT_MAX_METRICS=60

# NOTIFICATIONS
# ============================================================================
NOTIFICATION_DRIVER=logger

# STORAGE
# ============================================================================
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage
# S3-compatible storage (set STORAGE_DRIVER=s3 to enable).
# A local MinIO server ships with the stack: `docker compose --profile s3 up`.
# MinIO root credentials are taken from STORAGE_S3_ACCESS_KEY / STORAGE_S3_SECRET_KEY
# (the secret must be at least 8 characters). Endpoint: use `http://minio:9000`
# from inside the Docker network, `http://localhost:9000` from the host.
# STORAGE_S3_ENDPOINT=http://minio:9000
# STORAGE_S3_BUCKET=app-storage
# STORAGE_S3_ACCESS_KEY=minioadmin
# STORAGE_S3_SECRET_KEY=minioadmin
# STORAGE_S3_REGION=eu-west-1
# STORAGE_S3_FORCE_PATH_STYLE=true

# MAILER
# ============================================================================
MAILER_DRIVER=logger
MAILER_FROM=no-reply@example.com
MAILER_DEFAULT_TO=admin@example.com

# SMTP settings — required (non-empty) when the Documenso container is started.
# The docker-compose `documenso` service forwards these to NEXT_PRIVATE_SMTP_*
# with `:?` (fail on empty), so leaving them blank prevents the stack from
# coming up even if you do not actually use SMTP from the backend.
MAILER_SMTP_HOST=smtp.example.com
MAILER_SMTP_PORT=587
MAILER_SMTP_SECURE=false
MAILER_SMTP_USER=your-email@example.com
MAILER_SMTP_PASSWORD=your-smtp-password-here

# DOCUMENSO (self-hosted electronic signature)
# ============================================================================
# Backend reads these to talk to Documenso. The Docker stack additionally
# needs the DOCUMENSO_* keys below to boot the documenso container itself.
DOCUMENSO_URL=http://gazmatek-agency-documenso:3000
DOCUMENSO_API_KEY=
DOCUMENSO_WEBHOOK_SECRET=replace-with-strong-shared-secret

# Documenso container boot config (required by docker-compose if you start it)
# Ports DELIBERATELY different from event-planner (3002/9000/9001) so both
# stacks can run side-by-side. Override here if you also avoid event-planner.
DOCUMENSO_PORT=3003
DOCUMENSO_INTERNAL_PORT=3000
DOCUMENSO_APP_URL=http://localhost:3003
# Set to `false` to allow signup in the Documenso UI (needed once to create
# the admin account), then switch back to `true` to lock further signups.
NEXT_PUBLIC_DISABLE_SIGNUP=true
DOCUMENSO_DATABASE_URL=postgresql://user:password@db:5432/documenso
DOCUMENSO_DIRECT_DATABASE_URL=postgresql://user:password@db:5432/documenso
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOCUMENSO_SECRET_KEY=
# Generate each: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOCUMENSO_ENCRYPTION_KEY=
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=
# Self-signed PKCS#12 cert in base64 — needed by Documenso to sign PDFs.
# Quick dev cert generation (OpenSSL): see docker/DOCUMENSO.md
DOCUMENSO_SIGNING_CERT=
DOCUMENSO_SMTP_TRANSPORT=smtp
DOCUMENSO_SMTP_SECURE=false
DOCUMENSO_UPLOAD_TRANSPORT=s3
DOCUMENSO_PUBLIC_UPLOAD_TRANSPORT=s3
DOCUMENSO_UPLOAD_FORCE_PATH_STYLE=true
# Dev only: allow webhooks to localhost/private addresses
DOCUMENSO_WEBHOOK_SSRF_BYPASS_HOSTS=localhost,127.0.0.1,host.docker.internal

# PUPPETEER (PDF rendering through the `browser` service)
# ============================================================================
# In Docker, point the backend at the browserless container:
PUPPETEER_BROWSER_WS_ENDPOINT=ws://browser:3000
# Local dev (backend run outside Docker) — leave PUPPETEER_BROWSER_WS_ENDPOINT
# empty and Puppeteer will launch its bundled Chromium. To use the dockerised
# browser from the host, map BROWSER_PORT (default 3010) and set:
# PUPPETEER_BROWSER_WS_ENDPOINT=ws://localhost:3010

# MINIO (S3-compatible storage — required by Documenso)
# ============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=documenso
MINIO_REGION=eu-west-1
# Host port overrides — defaults picked to NOT clash with event-planner
# (which binds 9000/9001 for MinIO). Override here for your setup.
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
BROWSER_PORT=3011
