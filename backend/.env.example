# ============================================================================
# Backend Template - Environment Variables Example
# ============================================================================
# Copy this file to `.env` and adjust values for your environment.
# See docs/EnvVariables.md for detailed descriptions of each variable.
# ============================================================================

# APP CONFIGURATION
# ============================================================================
NODE_ENV=development
APP_NAME=backend-template
APP_VERSION=1.0.0
APP_BASE_URL=http://localhost:4001
PORT=4001
# IANA timezone used to interpret zone-less wall-clock values (helpers/timezone.ts)
APP_TIMEZONE=UTC

# SERVER
# ============================================================================
CORS_ORIGIN=http://localhost
TRUST_PROXY=true

# DATABASE (REQUIRED - must be configured for app to start)
# ============================================================================
# PostgreSQL connection settings. All DB_* variables are required.
DATABASE_HOST=localhost
DATABASE=mydb
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_PORT=5432

# Connection pool tuning (optional - sensible defaults shown)
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# AUTHENTICATION (required if AUTH_STRATEGIES includes 'jwt')
# ============================================================================
# JWT_KEY is required when AUTH_STRATEGIES includes 'jwt'.
# Recommendation: generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_KEY=your-secret-jwt-key-here-32-bytes-min

# Auth strategies to enable. Options: jwt, api-key
# Comma-separated list: "jwt,api-key" or single: "jwt"
AUTH_STRATEGIES=jwt

# API Key authentication
API_KEY_HEADER=x-api-key

# SECURITY (optional)
# ============================================================================
# 32-byte AES-256-GCM key (64 hex chars) for application-level field encryption.
# Only needed if you use helpers/crypto.ts. Leave unset otherwise.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DATA_ENCRYPTION_KEY=

# LOGGING
# ============================================================================
LOG_LEVEL=debug
LOG_PATH=logs

# FEATURES (optional - can be toggled on/off)
# ============================================================================
FEATURE_SWAGGER=true
FEATURE_METRICS=true
FEATURE_NOTIFICATIONS=false
FEATURE_STORAGE=true
FEATURE_MAILER=false
# Enable the background job scheduler (src/jobs/scheduler.ts)
FEATURE_JOBS=false

# SWAGGER / API DOCUMENTATION
# ============================================================================
SWAGGER_PATH=/docs
SWAGGER_JSON_PATH=/docs/json
SWAGGER_TITLE=Backend Template API

# METRICS (Prometheus)
# ============================================================================
METRICS_PATH=/metrics

# OBSERVABILITY
# ============================================================================
REQUEST_ID_HEADER=x-request-id

# RATE LIMITING
# ============================================================================
# Window size in milliseconds (default: 60 seconds)
RATE_LIMIT_WINDOW_MS=60000

# Max requests per window for different endpoint groups
RATE_LIMIT_MAX_API=300
RATE_LIMIT_MAX_AUTH=20
RATE_LIMIT_MAX_DOCS=60
RATE_LIMIT_MAX_METRICS=60

# NOTIFICATIONS (optional - requires FEATURE_NOTIFICATIONS=true)
# ============================================================================
# Driver: "logger" (console) or "telegram" (requires token & chat ID)
NOTIFICATION_DRIVER=logger

# Telegram settings (required only if NOTIFICATION_DRIVER=telegram)
# TELEGRAM_BOT_TOKEN=your-bot-token-here
# TELEGRAM_CHAT_ID=your-chat-id-here

# STORAGE (optional - requires FEATURE_STORAGE=true)
# ============================================================================
# Driver: "local" (file system based storage) or "s3" (S3-compatible storage)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage

# S3 settings (required only if STORAGE_DRIVER=s3 - works with AWS S3 or MinIO)
# STORAGE_S3_ENDPOINT=http://localhost:9000
# STORAGE_S3_BUCKET=my-bucket
# STORAGE_S3_ACCESS_KEY=your-access-key
# STORAGE_S3_SECRET_KEY=your-secret-key
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_FORCE_PATH_STYLE=true

# MAILER (optional - requires FEATURE_MAILER=true)
# ============================================================================
# Driver: "logger" (console), "smtp" (email server), or "disabled"
MAILER_DRIVER=logger
MAILER_FROM=no-reply@example.com
MAILER_DEFAULT_TO=admin@example.com

# SMTP settings (required only if MAILER_DRIVER=smtp)
# MAILER_SMTP_HOST=smtp.example.com
# MAILER_SMTP_PORT=587
# MAILER_SMTP_SECURE=false
# MAILER_SMTP_USER=your-email@example.com
# MAILER_SMTP_PASSWORD=your-smtp-password-here
