{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "nodemon --ext ts,js,json --ignore dist/ --exec \"ts-node -r tsconfig-paths/register\" src/index.ts",
    "start:api": "node dist/index.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "node scripts/build-runtime-assets.js clean && tsc && tsc-alias && node scripts/build-runtime-assets.js copy",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand --testPathPatterns=tests/integration",
    "db:migrate": "ts-node -r tsconfig-paths/register src/db/migrate.ts",
    "db:seed": "ts-node -r tsconfig-paths/register src/db/seed.ts",
    "generate-config": "ts-node -r tsconfig-paths/register src/db/generatePgTypedConfig.ts",
    "pgtyped": "npm run generate-config && pgtyped -c pgtyped.json --verbose",
    "documenso:register-webhook": "ts-node -r tsconfig-paths/register scripts/register-documenso-webhook.ts",
    "fix:all": "npm run format && npm run lint:fix",
    "check:all": "npm run format:check && npm run lint && npm run test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pgtyped/cli": "^2.4.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.2",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1049.0",
    "@pgtyped/query": "^2.4.2",
    "argon2": "^0.44.0",
    "axios": "^1.14.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "puppeteer-core": "^25.0.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  }
}
